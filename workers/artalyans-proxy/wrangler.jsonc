{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "artalyans-proxy",
  "main": "./index.js",
  "compatibility_date": "2026-05-02",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "artalyans.pro/*",
      "zone_name": "artalyans.pro"
    },
    {
      "pattern": "www.artalyans.pro/*",
      "zone_name": "artalyans.pro"
    }
  ],
  "observability": {
    "enabled": true
  }
}
